<Project>
    <PropertyGroup>
        <BaseTargetFramework>net10.0</BaseTargetFramework>
        <Authors>Allan Ritchie</Authors>
        <Owners>aritchie;shinylib</Owners>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <DisableExtraReferences>False</DisableExtraReferences>
        <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
        <Description>Shiny</Description>
        <Product>$(AssemblyName) ($(TargetFramework))</Product>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://shinylib.net</PackageProjectUrl>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReleaseNotes>https://shinylib.net/client/release-notes</PackageReleaseNotes>
        <PackageTags>ios android ble bluetooth bluetoothle push notifications sensors geofences gps location background jobs settings speech sensors</PackageTags>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/shinyorg/shiny</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        
        <CI Condition="'$(GITHUB_ACTIONS)' == 'true'">true</CI>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

        <!--
            Platform targets are dropped on hosts that cannot build them, the same way the Windows
            target is. The ios/maccatalyst/macos workloads refuse to install on Linux ("Workload ID
            ios isn't supported on this platform"), so leaving them in TargetFrameworks makes every
            multi-targeted project unbuildable there. Android installs everywhere, so it stays
            unconditional.

            The Windows target is only on by default on Windows hosts. CI builds and packs on
            macos-latest (the Live Activities binding needs Xcode), so it opts back in with
            -p:EnableWindowsTargeting=true - without that the shipped packages silently lose their
            net10.0-windows lib. The same switch compiles the Windows target on a Mac locally.
        -->
        <AppleTargetsSupported Condition="!$([MSBuild]::IsOSPlatform('linux'))">true</AppleTargetsSupported>

        <AndroidTarget>$(BaseTargetFramework)-android</AndroidTarget>
        <IosTarget Condition="'$(AppleTargetsSupported)' == 'true'">$(BaseTargetFramework)-ios</IosTarget>
        <MacCatalystTarget Condition="'$(AppleTargetsSupported)' == 'true'">$(BaseTargetFramework)-maccatalyst</MacCatalystTarget>
        <MacOsTarget Condition="'$(AppleTargetsSupported)' == 'true'">$(BaseTargetFramework)-macos</MacOsTarget>
        <TvOsTarget Condition="'$(AppleTargetsSupported)' == 'true'">$(BaseTargetFramework)-tvos</TvOsTarget>
        <WindowsTarget Condition="$([MSBuild]::IsOSPlatform('windows')) OR '$(EnableWindowsTargeting)' == 'true'">$(BaseTargetFramework)-windows10.0.19041.0</WindowsTarget>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <IncludeSource>True</IncludeSource>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>True</PublishRepositoryUrl>
        <EmbedUntrackedSources>True</EmbedUntrackedSources>
    </PropertyGroup>

    <PropertyGroup Condition="$(TargetFramework.Contains('android'))">
        <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion>35.0</TargetPlatformMinVersion>
        <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
        <AndroidUseIntermediateDesignerFile>false</AndroidUseIntermediateDesignerFile>
        <DefineConstants>$(DefineConstants);PLATFORM</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <DefineConstants>$(DefineConstants);APPLE;PLATFORM</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="$(TargetFramework.Contains('maccatalyst'))">
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion>15.0</TargetPlatformMinVersion>
        <DefineConstants>$(DefineConstants);APPLE;PLATFORM</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="$(TargetFramework.Contains('-macos'))">
        <DefineConstants>$(DefineConstants);APPLE;PLATFORM</DefineConstants>
    </PropertyGroup>

    <!--
        tvOS reuses the iOS platform code - IosPlatform, IosLifecycleExecutor and the UIApplication
        notifications are all present - so it defines APPLE and picks up Platforms\Apple. What it does
        not have is the peripheral/GATT-server role, NetworkExtension's hotspot APIs, CLMonitor, or
        any notification a user can tap; those are carved out with #if TVOS at the call site.
    -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-tvos'))">
        <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
        <DefineConstants>$(DefineConstants);APPLE;PLATFORM</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="$(TargetFramework.Contains('windows'))">
        <DefineConstants>$(DefineConstants);PLATFORM;WINDOWS</DefineConstants>
    </PropertyGroup>

    <!--
        Cross-compiling the Windows target from macOS: WinAppSDK's PRI step shells out to makepri.exe,
        which cannot run there, so the WinAppSDK projects (Shiny.Hosting.Maui) skip generating and
        packing their project .pri. None of these libraries carry XAML or resources - a Windows-built
        package's .pri is an empty resource index - so the app loses nothing without it.
    -->
    <PropertyGroup Condition="$(TargetFramework.Contains('windows')) AND !$([MSBuild]::IsOSPlatform('windows'))">
        <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
        <IncludeProjectPriFile>false</IncludeProjectPriFile>
    </PropertyGroup>
</Project>