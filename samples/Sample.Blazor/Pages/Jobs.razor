@page "/jobs"
@using Shiny.Jobs
@inject IJobManager JobManager

<PageTitle>Jobs</PageTitle>

<h1>Jobs</h1>

<div class="mb-3">
    <button class="btn btn-primary me-2" @onclick="@(() => LoadJobs())">Refresh</button>
    <button class="btn btn-success me-2" @onclick="RunAll">Run All</button>
    <button class="btn btn-warning" @onclick="RunSample">Run SampleJob</button>
</div>

@if (!string.IsNullOrEmpty(status))
{
    <div class="alert alert-info">@status</div>
}

@if (jobs.Count == 0)
{
    <p>No jobs registered.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Identifier</th><th>Type</th><th>Foreground</th><th>Network</th></tr>
        </thead>
        <tbody>
            @foreach (var job in jobs)
            {
                <tr>
                    <td>@job.Identifier</td>
                    <td>@job.JobType.Name</td>
                    <td>@job.RunOnForeground</td>
                    <td>@job.RequiredInternetAccess</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    IList<JobInfo> jobs = new List<JobInfo>();
    string? status;

    protected override void OnInitialized() => LoadJobs();

    void LoadJobs()
    {
        jobs = JobManager.GetJobs();
        status = $"Loaded {jobs.Count} job(s)";
    }

    async Task RunAll()
    {
        var results = await JobManager.RunAll(CancellationToken.None);
        status = $"Ran {System.Linq.Enumerable.Count(results)} job(s)";
    }

    async Task RunSample()
    {
        var result = await JobManager.Run("SampleJob", CancellationToken.None);
        status = result.Success ? "SampleJob ran OK" : $"SampleJob failed: {result.Exception?.Message}";
    }
}
