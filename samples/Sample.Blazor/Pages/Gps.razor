@page "/gps"
@using Shiny.Locations
@implements IAsyncDisposable
@inject IGpsManager GpsService
@inject IGeocoder Geocoder

<PageTitle>GPS</PageTitle>

<h1>GPS</h1>

<p>
    Live GPS readings via the browser's Geolocation API. Blazor WebAssembly cannot run in
    the background — readings only flow while this tab is open and focused. There is no
    geofencing API in the browser, so <code>Shiny.Locations.Blazor</code> ships GPS only.
</p>

<div class="mb-3">
    <button class="btn btn-secondary me-2" @onclick="GetLast">Get Current</button>
    <button class="btn btn-primary me-2" @onclick="Start" disabled="@isListening">Start Listener</button>
    <button class="btn btn-danger me-2" @onclick="Stop" disabled="@(!isListening)">Stop Listener</button>
    <button class="btn btn-outline-primary me-2" @onclick="ReverseGeocode" disabled="@(reading == null || isGeocoding)">Reverse Geocode</button>
</div>

@if (error != null)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table">
    <tbody>
        <tr><th>Access</th><td>@access</td></tr>
        <tr><th>Listening</th><td>@isListening</td></tr>
        <tr><th>Latitude</th><td>@reading?.Position.Latitude</td></tr>
        <tr><th>Longitude</th><td>@reading?.Position.Longitude</td></tr>
        <tr><th>Accuracy (m)</th><td>@reading?.PositionAccuracy</td></tr>
        <tr><th>Altitude</th><td>@reading?.Altitude</td></tr>
        <tr><th>Heading</th><td>@reading?.Heading</td></tr>
        <tr><th>Speed</th><td>@reading?.Speed</td></tr>
        <tr><th>Timestamp</th><td>@reading?.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td></tr>
    </tbody>
</table>

@if (placemark != null)
{
    <h2 class="h5 mt-4">Address</h2>
    <table class="table">
        <tbody>
            <tr><th>Address</th><td>@placemark.FormattedAddress</td></tr>
            <tr><th>Street</th><td>@placemark.SubThoroughfare @placemark.Thoroughfare</td></tr>
            <tr><th>Locality</th><td>@placemark.Locality</td></tr>
            <tr><th>Region</th><td>@placemark.AdministrativeArea</td></tr>
            <tr><th>Postal Code</th><td>@placemark.PostalCode</td></tr>
            <tr><th>Country</th><td>@placemark.CountryName (@placemark.CountryCode)</td></tr>
        </tbody>
    </table>
    @* OpenStreetMap requires attribution wherever Nominatim results are shown *@
    <p class="text-muted small">
        Address data <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">@NominatimOptions.Attribution</a>
    </p>
}
else if (geocodeStatus != null)
{
    <p class="text-muted">@geocodeStatus</p>
}

@code {
    GpsReading? reading;
    AccessState access = AccessState.Unknown;
    bool isListening;
    string? error;
    Placemark? placemark;
    string? geocodeStatus;
    bool isGeocoding;

    protected override void OnInitialized()
    {
        GpsService.GpsReadingReceived += OnGpsReading;
    }

    void OnGpsReading(object? sender, GpsReading r)
    {
        InvokeAsync(() =>
        {
            reading = r;
            error = null;
            StateHasChanged();
        });
    }

    async Task GetLast()
    {
        try
        {
            error = null;
            access = await GpsService.RequestAccess(GpsRequest.Foreground);
            if (access != AccessState.Available)
                return;

            reading = await GpsService.GetLastReading();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    async Task ReverseGeocode()
    {
        if (reading == null)
            return;

        try
        {
            error = null;
            isGeocoding = true;
            placemark = null;
            geocodeStatus = "Looking up...";

            var results = await Geocoder.ReverseGeocode(reading.Position);
            placemark = results.FirstOrDefault();
            geocodeStatus = placemark == null ? "No address found" : null;
        }
        catch (Exception ex)
        {
            geocodeStatus = null;
            error = ex.Message;
        }
        finally
        {
            isGeocoding = false;
        }
    }

    async Task Start()
    {
        try
        {
            error = null;
            access = await GpsService.RequestAccess(GpsRequest.Foreground);
            if (access != AccessState.Available)
                return;

            await GpsService.StartListener(GpsRequest.Foreground);
            isListening = true;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    async Task Stop()
    {
        try
        {
            await GpsService.StopListener();
            isListening = false;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    public async ValueTask DisposeAsync()
    {
        GpsService.GpsReadingReceived -= OnGpsReading;
        if (isListening)
            await GpsService.StopListener();
    }
}
