<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)-tvos</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>

        <ApplicationTitle>Shiny tvOS</ApplicationTitle>
        <ApplicationId>org.shiny.sample.tvos</ApplicationId>

        <!-- this is a sample, not a shipped package -->
        <IsPackable>false</IsPackable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!--
            Every Shiny module that has a net10.0-tvos target. Absent by design, because Apple
            gives tvOS no API to build them on: Shiny.BluetoothLE.Hosting (no peripheral role),
            Shiny.Net.Wifi (no NetworkExtension hotspot APIs), Shiny.Locations (no CLMonitor),
            Shiny.Notifications (a tvOS notification can only change the app icon badge).
        -->
        <ProjectReference Include="..\..\src\Shiny.Hosting.Native\Shiny.Hosting.Native.csproj" />
        <ProjectReference Include="..\..\src\Shiny.BluetoothLE\Shiny.BluetoothLE.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Net.Discovery\Shiny.Net.Discovery.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Net.Http\Shiny.Net.Http.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Jobs\Shiny.Jobs.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Push\Shiny.Push.csproj" />
        <ProjectReference Include="..\..\src\Shiny.ScreenRecorder\Shiny.ScreenRecorder.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Data.Sync\Shiny.Data.Sync.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- direct reference so the [ShinyJsonContext] source generator/analyzer runs in this project -->
        <PackageReference Include="Shiny.Extensions.Serialization" />
    </ItemGroup>

</Project>
