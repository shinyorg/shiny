<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.Shared.Maui.Pages.Push"
             x:Class="Sample.Shared.Maui.Pages.Push.PushPage"
             x:DataType="vm:PushViewModel"
             Title="Push Notifications">
    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="12">
            <Button Text="Register" Command="{Binding RegisterCommand}" />
            <Button Text="UnRegister" Command="{Binding UnRegisterCommand}" />
            <Label Text="{Binding Status}" FontSize="14" />
            <Label Text="Token:" FontAttributes="Bold" />
            <Label Text="{Binding Token}" FontSize="12" IsTextSelectionEnabled="True" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
