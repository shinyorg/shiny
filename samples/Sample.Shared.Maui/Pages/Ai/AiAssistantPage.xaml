<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Sample.Shared.Maui.Pages.Ai"
             x:Class="Sample.Shared.Maui.Pages.Ai.AiAssistantPage"
             x:DataType="local:AiAssistantViewModel"
             Title="AI Assistant">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:InvertBoolConverter x:Key="InvertBool" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="10">

        <!-- Sign-in bar -->
        <Border Grid.Row="0" StrokeThickness="0" Padding="14,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label Text="GitHub Copilot" FontSize="15" FontAttributes="Bold" />
                    <Label FontSize="12" TextColor="Gray">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSignedIn}" Value="True">
                                <Setter Property="Text" Value="Signed in — ask me anything" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSignedIn}" Value="False">
                                <Setter Property="Text" Value="Sign in to run AI queries" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>

                <Button Grid.Column="1" Text="Sign in"
                        IsVisible="{Binding IsSignedIn, Converter={StaticResource InvertBool}}"
                        Command="{Binding SignInCommand}"
                        CornerRadius="10" HeightRequest="40" Padding="16,0" />
                <Button Grid.Column="1" Text="Sign out"
                        IsVisible="{Binding IsSignedIn}"
                        Command="{Binding SignOutCommand}"
                        CornerRadius="10" HeightRequest="40" Padding="16,0" />
            </Grid>
        </Border>

        <!-- Transcript -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Messages}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                    <Label Text="🤖" FontSize="40" HorizontalTextAlignment="Center" />
                    <Label Text="Try: &quot;what's on my calendar this week?&quot;, &quot;schedule lunch with Alex tomorrow at noon&quot;, or &quot;remind me to call mom at 6pm&quot;"
                           FontSize="13" HorizontalTextAlignment="Center" TextColor="Gray" />
                    <Label Text="{Binding ToolSummary}"
                           FontSize="11" HorizontalTextAlignment="Center" TextColor="Gray" Margin="0,12,0,0" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:AiMessage">
                    <Grid Padding="2,4">
                        <Border StrokeThickness="0" Padding="12,8"
                                BackgroundColor="{Binding Background}"
                                HorizontalOptions="{Binding Align}"
                                MaximumWidthRequest="320">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label Text="{Binding Text}" TextColor="{Binding TextColor}" FontSize="14" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Input bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Border Grid.Column="0" StrokeThickness="0" Padding="12,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Entry Text="{Binding Input}"
                       Placeholder="Ask your assistant…"
                       ReturnType="Send"
                       ReturnCommand="{Binding SendCommand}"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
            </Border>
            <Button Grid.Column="1" Text="➤" FontSize="18"
                    WidthRequest="48" HeightRequest="48" CornerRadius="24" Padding="0"
                    Command="{Binding SendCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
        </Grid>

        <!-- Busy -->
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,8" />
    </Grid>
</ContentPage>
