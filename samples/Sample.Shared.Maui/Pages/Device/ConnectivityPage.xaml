<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.Shared.Maui.Pages.Device"
             x:Class="Sample.Shared.Maui.Pages.Device.ConnectivityPage"
             x:DataType="vm:ConnectivityViewModel"
             Title="Connectivity">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Access" FontAttributes="Bold" />
        <Label Text="{Binding Access}" />

        <Label Text="Connection Types" FontAttributes="Bold" />
        <Label Text="{Binding ConnectionTypes}" />
    </VerticalStackLayout>
</ContentPage>
