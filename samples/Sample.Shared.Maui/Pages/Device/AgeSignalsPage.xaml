<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.Shared.Maui.Pages.Device"
             x:Class="Sample.Shared.Maui.Pages.Device.AgeSignalsPage"
             x:DataType="vm:AgeSignalsViewModel"
             Title="Age Signals">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="Eligibility" FontAttributes="Bold" />
            <Label Text="{Binding Eligibility}" AutomationId="Eligibility" />
            <Button Text="Check Eligibility" Command="{Binding CheckEligibilityCommand}" AutomationId="CheckEligibility" />

            <Label Text="Age gates (Apple)" FontAttributes="Bold" Margin="0,12,0,0" />
            <Entry Text="{Binding Gates}" Placeholder="13,16,18" Keyboard="Numeric" />
            <Button Text="Request Age Range" Command="{Binding RequestCommand}" AutomationId="RequestAgeRange" />

            <Label Text="Result" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label Text="{Binding Result}" AutomationId="Result" />

            <Label Text="Significant update (iOS 26.4+)" FontAttributes="Bold" Margin="0,12,0,0" />
            <Entry Text="{Binding UpdateDescription}" />
            <Button Text="Show Acknowledgment" Command="{Binding ShowSignificantUpdateCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
