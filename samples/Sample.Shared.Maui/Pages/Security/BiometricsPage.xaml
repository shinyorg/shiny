<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.Shared.Maui.Pages.Security"
             x:Class="Sample.Shared.Maui.Pages.Security.BiometricsPage"
             x:DataType="vm:BiometricsViewModel"
             Title="Biometrics">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="Availability" FontAttributes="Bold" />
            <Label Text="{Binding Availability}" AutomationId="Availability" />
            <HorizontalStackLayout Spacing="8">
                <Switch IsToggled="{Binding Weak}" />
                <Label Text="Android: weak (class 2) biometrics" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Button Text="Check Availability" Command="{Binding CheckCommand}" AutomationId="CheckAvailability" />

            <Label Text="Prompt" FontAttributes="Bold" Margin="0,12,0,0" />
            <Entry Text="{Binding Reason}" Placeholder="Reason shown in the prompt" />
            <HorizontalStackLayout Spacing="8">
                <Switch IsToggled="{Binding AllowDeviceCredential}" />
                <Label Text="Allow passcode / PIN fallback" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Button Text="Authenticate" Command="{Binding AuthenticateCommand}" AutomationId="Authenticate" />

            <Label Text="Result" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label Text="{Binding Result}" AutomationId="Result" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
