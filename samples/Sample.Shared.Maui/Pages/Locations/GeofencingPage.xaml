<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:vm="clr-namespace:Sample.Shared.Maui.Pages.Locations"
             x:Class="Sample.Shared.Maui.Pages.Locations.GeofencingPage"
             x:DataType="vm:GeofencingViewModel"
             Title="Geofencing">
    <shiny:TableView>
        <shiny:TableRoot>
            <shiny:TableSection Title="Create Geofence">
                <shiny:EntryCell Title="Identifier" ValueText="{Binding Identifier, Mode=TwoWay}" Placeholder="auto-generated if blank" />
                <shiny:EntryCell Title="Latitude" ValueText="{Binding Latitude, Mode=TwoWay}" Keyboard="Numeric" Placeholder="e.g. 37.7749" />
                <shiny:EntryCell Title="Longitude" ValueText="{Binding Longitude, Mode=TwoWay}" Keyboard="Numeric" Placeholder="e.g. -122.4194" />
                <shiny:EntryCell Title="Radius (m)" ValueText="{Binding RadiusMeters, Mode=TwoWay}" Keyboard="Numeric" Placeholder="200" />
                <shiny:SwitchCell Title="Notify on Entry" On="{Binding NotifyOnEntry, Mode=TwoWay}" />
                <shiny:SwitchCell Title="Notify on Exit" On="{Binding NotifyOnExit, Mode=TwoWay}" />
                <shiny:SwitchCell Title="Single Use" On="{Binding SingleUse, Mode=TwoWay}" />
                <shiny:CommandCell Title="Use Current Location" Command="{Binding UseCurrentLocationCommand}" ShowArrow="False" />
                <shiny:ButtonCell Title="Add Geofence" Command="{Binding AddGeofenceCommand}" />
            </shiny:TableSection>

            <shiny:TableSection Title="Actions">
                <shiny:ButtonCell Title="Remove All" Command="{Binding RemoveAllCommand}" ButtonTextColor="Red" />
                <shiny:LabelCell Title="Status" ValueText="{Binding Status}" />
            </shiny:TableSection>

            <shiny:TableSection Title="Monitored Regions (tap to remove)" ItemsSource="{Binding Regions}">
                <shiny:TableSection.ItemTemplate>
                    <DataTemplate x:DataType="vm:GeofenceRegionViewModel">
                        <shiny:CommandCell Title="{Binding Identifier}" ValueText="{Binding CurrentState}" Description="{Binding Position}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GeofencingViewModel}}, Path=RemoveGeofenceCommand}"
                                           CommandParameter="{Binding Identifier}" ShowArrow="False" />
                    </DataTemplate>
                </shiny:TableSection.ItemTemplate>
            </shiny:TableSection>
        </shiny:TableRoot>
    </shiny:TableView>
</ContentPage>
