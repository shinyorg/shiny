<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:vm="clr-namespace:Sample.Shared.Maui.Pages.Locations"
             x:Class="Sample.Shared.Maui.Pages.Locations.MotionActivityPage"
             x:DataType="vm:MotionActivityViewModel"
             Title="Motion Activity">
    <shiny:TableView>
        <shiny:TableRoot>
            <shiny:TableSection Title="Actions">
                <shiny:ButtonCell Title="{Binding ListenText}" Command="{Binding ToggleListenerCommand}" />
                <shiny:ButtonCell Title="Get Last Reading" Command="{Binding GetLastReadingCommand}" />
                <shiny:ButtonCell Title="Check Permission" Command="{Binding CheckPermissionCommand}" />
                <shiny:LabelCell Title="Status" ValueText="{Binding Status}" />
            </shiny:TableSection>

            <shiny:TableSection Title="Current Reading">
                <shiny:LabelCell Title="Activity" ValueText="{Binding Activity}" />
                <shiny:LabelCell Title="Confidence" ValueText="{Binding Confidence}" />
                <shiny:LabelCell Title="Timestamp" ValueText="{Binding Timestamp}" />
            </shiny:TableSection>
        </shiny:TableRoot>
    </shiny:TableView>
</ContentPage>
