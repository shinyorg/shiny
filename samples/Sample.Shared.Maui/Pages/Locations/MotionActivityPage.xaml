<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tv="http://shiny.net/maui/tableview"
             xmlns:vm="clr-namespace:Sample.Shared.Maui.Pages.Locations"
             x:Class="Sample.Shared.Maui.Pages.Locations.MotionActivityPage"
             x:DataType="vm:MotionActivityViewModel"
             Title="Motion Activity">
    <tv:TableView>
        <tv:TableRoot>
            <tv:TableSection Title="Actions">
                <tv:ButtonCell Title="{Binding ListenText}" Command="{Binding ToggleListenerCommand}" />
                <tv:ButtonCell Title="Get Last Reading" Command="{Binding GetLastReadingCommand}" />
                <tv:ButtonCell Title="Check Permission" Command="{Binding CheckPermissionCommand}" />
                <tv:LabelCell Title="Status" ValueText="{Binding Status}" />
            </tv:TableSection>

            <tv:TableSection Title="Current Reading">
                <tv:LabelCell Title="Activity" ValueText="{Binding Activity}" />
                <tv:LabelCell Title="Confidence" ValueText="{Binding Confidence}" />
                <tv:LabelCell Title="Timestamp" ValueText="{Binding Timestamp}" />
            </tv:TableSection>
        </tv:TableRoot>
    </tv:TableView>
</ContentPage>
