<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:vm="clr-namespace:Sample.Shared.Maui.Pages.HttpTransfers"
             xmlns:http="clr-namespace:Shiny.Net.Http;assembly=Shiny.Net.Http"
             x:Class="Sample.Shared.Maui.Pages.HttpTransfers.HttpTransferListPage"
             x:DataType="vm:HttpTransferListViewModel"
             Title="HTTP Transfers">
    <shiny:TableView>
        <shiny:TableRoot>
            <shiny:TableSection Title="Create">
                <shiny:CommandCell Title="New Download" Command="{Binding GoToDownloadCommand}" />
                <shiny:CommandCell Title="New Upload" Command="{Binding GoToUploadCommand}" />
                <shiny:CommandCell Title="Azure Blob Upload" Command="{Binding GoToAzureBlobCommand}" />
            </shiny:TableSection>

            <shiny:TableSection Title="Manage">
                <shiny:ButtonCell Title="Cancel All" Command="{Binding CancelAllCommand}" ButtonTextColor="Red" />
            </shiny:TableSection>

            <shiny:TableSection Title="Transfers" ItemsSource="{Binding Transfers}">
                <shiny:TableSection.ItemTemplate>
                    <DataTemplate x:DataType="http:HttpTransferObject">
                        <shiny:CustomCell>
                            <shiny:CustomCell.CustomContent>
                                <VerticalStackLayout Padding="8" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Identifier}" FontAttributes="Bold" />
                                        <Label Grid.Column="1" Text="{Binding Status}" />
                                    </Grid>
                                    <Label Text="{Binding Uri}" FontSize="12" TextColor="Gray" LineBreakMode="TailTruncation" />
                                    <ProgressBar Progress="{Binding PercentComplete}" IsVisible="{Binding IsDeterministic}" ProgressColor="{StaticResource Primary}" />
                                    <Grid ColumnDefinitions="*,*,Auto">
                                        <Label Text="{Binding BytesTransferred, StringFormat='{0:N0} bytes'}" FontSize="12" />
                                        <Label Grid.Column="1" Text="{Binding BytesPerSecond, StringFormat='{0:N0} B/s'}" FontSize="12" />
                                        <Label Grid.Column="2" Text="{Binding EstimatedTimeRemaining, StringFormat='{0:hh\\:mm\\:ss}'}" FontSize="12" />
                                    </Grid>
                                </VerticalStackLayout>
                            </shiny:CustomCell.CustomContent>
                        </shiny:CustomCell>
                    </DataTemplate>
                </shiny:TableSection.ItemTemplate>
            </shiny:TableSection>
        </shiny:TableRoot>
    </shiny:TableView>
</ContentPage>
