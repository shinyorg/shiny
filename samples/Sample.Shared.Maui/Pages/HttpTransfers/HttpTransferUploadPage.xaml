<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:vm="clr-namespace:Sample.Shared.Maui.Pages.HttpTransfers"
             x:Class="Sample.Shared.Maui.Pages.HttpTransfers.HttpTransferUploadPage"
             x:DataType="vm:HttpTransferUploadViewModel"
             Title="New Upload">
    <shiny:TableView>
        <shiny:TableRoot>
            <shiny:TableSection Title="Upload">
                <shiny:EntryCell Title="Identifier" ValueText="{Binding Identifier, Mode=TwoWay}" />
                <shiny:EntryCell Title="URI" ValueText="{Binding Uri, Mode=TwoWay}" Placeholder="https://example.com/upload" />
                <shiny:LabelCell Title="Selected File" ValueText="{Binding SelectedFileName}" Description="Tap 'Pick File' to choose" />
                <shiny:CommandCell Title="Pick File" Command="{Binding PickFileCommand}" ShowArrow="False" />
                <shiny:TextPickerCell Title="Transfer Type" ItemsSource="{Binding TransferTypes}" SelectedIndex="{Binding SelectedTransferTypeIndex, Mode=TwoWay}" />
                <shiny:EntryCell Title="File Form Data Name" ValueText="{Binding FileFormDataName, Mode=TwoWay}" Placeholder="file" />
                <shiny:EntryCell Title="HTTP Method" ValueText="{Binding HttpMethod, Mode=TwoWay}" Placeholder="POST" />
            </shiny:TableSection>

            <shiny:TableSection Title="Options">
                <shiny:SwitchCell Title="Use Metered Connection" On="{Binding UseMeteredConnection, Mode=TwoWay}" />
            </shiny:TableSection>

            <shiny:TableSection Title="Custom Headers">
                <shiny:EntryCell Title="Key" ValueText="{Binding HeaderKey, Mode=TwoWay}" Placeholder="Header name" />
                <shiny:EntryCell Title="Value" ValueText="{Binding HeaderValue, Mode=TwoWay}" Placeholder="Header value" />
                <shiny:ButtonCell Title="Add Header" Command="{Binding AddHeaderCommand}" />
            </shiny:TableSection>

            <shiny:TableSection Title="Headers" ItemsSource="{Binding Headers}">
                <shiny:TableSection.ItemTemplate>
                    <DataTemplate x:DataType="vm:HeaderViewModel">
                        <shiny:CommandCell Title="{Binding Key}" ValueText="{Binding Value}"
                                        Command="{Binding BindingContext.RemoveHeaderCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}" ShowArrow="False" />
                    </DataTemplate>
                </shiny:TableSection.ItemTemplate>
            </shiny:TableSection>

            <shiny:TableSection Title="HTTP Content">
                <shiny:TextPickerCell Title="Content Type" ItemsSource="{Binding ContentTypes}" SelectedIndex="{Binding SelectedContentTypeIndex, Mode=TwoWay}" />
            </shiny:TableSection>

            <shiny:TableSection Title="JSON Content" IsVisible="{Binding IsJsonVisible}">
                <shiny:EntryCell Title="JSON Body" ValueText="{Binding JsonBody, Mode=TwoWay}" Placeholder="JSON content" />
                <shiny:EntryCell Title="Content Form Data Name" ValueText="{Binding ContentFormDataName, Mode=TwoWay}" Placeholder="Optional" />
            </shiny:TableSection>

            <shiny:TableSection Title="Form Data" IsVisible="{Binding IsFormDataVisible}">
                <shiny:EntryCell Title="Key" ValueText="{Binding FormDataKey, Mode=TwoWay}" Placeholder="Form data key" />
                <shiny:EntryCell Title="Value" ValueText="{Binding FormDataValue, Mode=TwoWay}" Placeholder="Form data value" />
                <shiny:ButtonCell Title="Add Form Data" Command="{Binding AddFormDataCommand}" />
            </shiny:TableSection>

            <shiny:TableSection Title="Form Data Pairs" IsVisible="{Binding IsFormDataVisible}" ItemsSource="{Binding FormDataPairs}">
                <shiny:TableSection.ItemTemplate>
                    <DataTemplate x:DataType="vm:HeaderViewModel">
                        <shiny:CommandCell Title="{Binding Key}" ValueText="{Binding Value}"
                                        Command="{Binding BindingContext.RemoveFormDataCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}" ShowArrow="False" />
                    </DataTemplate>
                </shiny:TableSection.ItemTemplate>
            </shiny:TableSection>

            <shiny:TableSection>
                <shiny:ButtonCell Title="Queue Upload" Command="{Binding QueueCommand}" />
                <shiny:LabelCell Title="Status" ValueText="{Binding Status}" />
            </shiny:TableSection>
        </shiny:TableRoot>
    </shiny:TableView>
</ContentPage>
