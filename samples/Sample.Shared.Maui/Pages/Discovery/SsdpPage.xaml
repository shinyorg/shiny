<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.Shared.Maui.Pages.Discovery"
             x:Class="Sample.Shared.Maui.Pages.Discovery.SsdpPage"
             x:DataType="vm:SsdpViewModel"
             Title="SSDP / UPnP">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16" RowSpacing="8">
        <Entry Grid.Row="0"
               Text="{Binding SearchTarget, Mode=TwoWay}"
               Placeholder="Search target, e.g. ssdp:all or upnp:rootdevice" />

        <Button Grid.Row="1" Text="{Binding BrowseText}" Command="{Binding ToggleBrowseCommand}" />

        <Label Grid.Row="2" Text="{Binding Status}" FontAttributes="Italic" />

        <Label Grid.Row="3"
               Text="Tap a device to fetch its UPnP description"
               FontSize="11"
               TextColor="Gray" />

        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding Devices}"
                        SelectionMode="Single"
                        SelectionChangedCommand="{Binding DescribeCommand}"
                        SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}">
            <CollectionView.EmptyView>
                <Label Text="No devices" HorizontalTextAlignment="Center" TextColor="Gray" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SsdpItem">
                    <Border Padding="8" Margin="0,4" StrokeThickness="1" Stroke="Gray">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding DeviceType}" FontAttributes="Bold" />
                            <Label Text="{Binding Server}" FontSize="12" />
                            <Label Text="{Binding Location}" FontSize="11" TextColor="Gray" />
                            <Label Text="{Binding Udn}" FontSize="10" TextColor="Gray" />
                            <Label Text="{Binding Summary}" FontSize="10" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
