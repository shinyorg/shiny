<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.Shared.Maui.Pages.Jobs"
             x:Class="Sample.Shared.Maui.Pages.Jobs.JobsPage"
             x:DataType="vm:JobsViewModel"
             Title="Jobs">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,*" Padding="16" RowSpacing="8">
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Button Text="Run All" Command="{Binding RunAllCommand}" />
        </HorizontalStackLayout>

        <Label Grid.Row="1" Text="{Binding Status}" FontAttributes="Italic" />

        <Label Grid.Row="2" Text="Registered Jobs" FontAttributes="Bold" />
        <CollectionView Grid.Row="3" ItemsSource="{Binding Jobs}">
            <CollectionView.EmptyView>
                <Label Text="No jobs registered" HorizontalTextAlignment="Center" TextColor="Gray" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:JobItemViewModel">
                    <Border Padding="8" Margin="0,4" StrokeThickness="1" Stroke="Gray">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Identifier}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding JobType}" FontSize="12" TextColor="Gray" />
                            <Label Grid.Row="2" Grid.Column="0" Text="{Binding Requirements}" FontSize="12" />
                            <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Text="Run"
                                    Command="{Binding RunCommand}" CommandParameter="{Binding Identifier}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" Text="Run Log" FontAttributes="Bold" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Clear" Command="{Binding ClearLogCommand}" />
        </Grid>
        <CollectionView Grid.Row="5" ItemsSource="{Binding RunLog}">
            <CollectionView.EmptyView>
                <Label Text="No runs yet" HorizontalTextAlignment="Center" TextColor="Gray" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:JobRunEntry">
                    <Grid Padding="8,4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{Binding Timestamp, StringFormat='{0:HH:mm:ss}'}" TextColor="Gray" />
                        <Label Grid.Column="1" Text="{Binding Identifier}" />
                        <Label Grid.Column="2" Text="{Binding Outcome}" FontAttributes="Bold" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
