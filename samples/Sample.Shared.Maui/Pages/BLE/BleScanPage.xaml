<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.Shared.Maui.Pages.BLE"
             x:Class="Sample.Shared.Maui.Pages.BLE.BleScanPage"
             x:DataType="vm:BleScanViewModel"
             Title="BLE Scanner">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" Padding="16" RowSpacing="6">
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Button Text="{Binding ScanText}" Command="{Binding ToggleScanCommand}" />
            <Button Text="Clear" Command="{Binding ClearResultsCommand}" />
        </HorizontalStackLayout>

        <Label Grid.Row="1" Text="{Binding Status}" FontAttributes="Italic" />

        <Entry Grid.Row="2" Text="{Binding ServiceUuidFilter, Mode=TwoWay}"
               Placeholder="Scan filter: service UUIDs (comma-separated, e.g. 180D,180F)" />

        <Entry Grid.Row="3" Text="{Binding NameFilter, Mode=TwoWay}"
               Placeholder="Filter by name contains..." />

        <Label Grid.Row="4" Text="{Binding RssiThreshold, StringFormat='Min RSSI: {0} dBm'}" />
        <Slider Grid.Row="5" Minimum="-100" Maximum="-30"
                Value="{Binding RssiThreshold, Mode=TwoWay}" />

        <Label Grid.Row="6"
               Text="{Binding VisibleCount, StringFormat='Showing {0} of '}"
               HorizontalOptions="Start">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Showing " />
                    <Span Text="{Binding VisibleCount}" FontAttributes="Bold" />
                    <Span Text=" of " />
                    <Span Text="{Binding DiscoveredCount}" FontAttributes="Bold" />
                    <Span Text=" discovered" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <CollectionView Grid.Row="7"
                        ItemsSource="{Binding Peripherals}"
                        SelectionMode="Single"
                        SelectionChangedCommand="{Binding SelectPeripheralCommand}"
                        SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}">
            <CollectionView.EmptyView>
                <Label Text="No peripherals" HorizontalTextAlignment="Center" TextColor="Gray" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PeripheralViewModel">
                    <Border Padding="8" Margin="0,4" StrokeThickness="1" Stroke="Gray"
                            IsVisible="{Binding IsVisible}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Rssi, StringFormat='{0} dBm'}" FontAttributes="Bold" VerticalOptions="Center" />

                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding Uuid}" FontSize="11" TextColor="Gray" />

                            <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="TxPower: " />
                                        <Span Text="{Binding TxPower, TargetNullValue='—'}" />
                                        <Span Text="   Connectable: " />
                                        <Span Text="{Binding IsConnectable, TargetNullValue='?'}" />
                                        <Span Text="   Seen: " />
                                        <Span Text="{Binding SeenCount}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Services: " />
                                        <Span Text="{Binding ServiceUuids}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Label Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Mfr: " />
                                        <Span Text="{Binding ManufacturerInfo}" />
                                        <Span Text="   Last: " />
                                        <Span Text="{Binding LastSeen, StringFormat='{0:HH:mm:ss}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
