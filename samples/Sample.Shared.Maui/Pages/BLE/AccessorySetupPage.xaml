<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.Shared.Maui.Pages.BLE"
             x:Class="Sample.Shared.Maui.Pages.BLE.AccessorySetupPage"
             x:DataType="vm:AccessorySetupViewModel"
             Title="Accessory Setup">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{Binding Status}" FontSize="16" FontAttributes="Bold" />
            <Label Text="{Binding Support}" FontSize="12" TextColor="Gray" />

            <Frame Padding="12" HasShadow="False" BorderColor="Gray">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Find an accessory" FontAttributes="Bold" />
                    <Label FontSize="12" TextColor="Gray"
                           Text="Run 'Accessory Advertiser' on a second device (phone, Mac or PC), then open the system picker here." />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Name must contain 'Shiny'" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding UseNameFilter}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Only when held next to the phone (iOS)" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ImmediateRange}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Requires LE pairing (iOS)" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding RequiresPairing}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Single device dialog (Android)" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding SingleDevice}" />
                    </Grid>

                    <Button Text="Show Picker" Command="{Binding ShowPickerCommand}" IsEnabled="{Binding IsSupported}" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="12" HasShadow="False" BorderColor="Gray">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Granted accessories" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Refresh" FontSize="12" Padding="8,2" Command="{Binding RefreshCommand}" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Accessories}" SelectionMode="Single">
                        <CollectionView.EmptyView>
                            <Label Text="Nothing granted yet" HorizontalTextAlignment="Center" TextColor="Gray" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccessoryItem">
                                <Border Padding="8" Margin="0,4" StrokeThickness="1" Stroke="Gray">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                                        <Label Text="{Binding Detail}" FontSize="11" TextColor="Gray" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Button Text="Connect &amp; Read" FontSize="12" Padding="8,2"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccessorySetupViewModel}}, Path=ConnectAndReadCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="{Binding PresenceText}" FontSize="12" Padding="8,2"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccessorySetupViewModel}}, Path=TogglePresenceCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:AccessorySetupViewModel}}, Path=IsPresenceSupported}" />
                                            <Button Text="Remove" FontSize="12" Padding="8,2"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccessorySetupViewModel}}, Path=RemoveCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="12" HasShadow="False" BorderColor="Gray">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Log (also on the Events page)" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Clear" FontSize="12" Padding="8,2" Command="{Binding ClearLogCommand}" />
                    </Grid>
                    <CollectionView ItemsSource="{Binding Log}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No activity yet" HorizontalTextAlignment="Center" TextColor="Gray" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" FontSize="12" Margin="0,2" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
