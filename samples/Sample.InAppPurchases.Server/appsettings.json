{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "InAppPurchases": {
    // Remove a store section entirely to disable that store's endpoint
    "Apple": {
      // Your app's bundle identifier (must match every notification/transaction)
      "BundleId": "net.shinylib.paysample",

      // App Store Connect → your app → App Information → General Information → Apple ID (numeric)
      // Required before Production notifications are accepted
      "AppAppleId": null,

      // Accept TestFlight / sandbox tester notifications
      "AllowSandbox": true,

      // Optional - only needed for IAppleStoreClient.GetTransactionAsync / GetSubscriptionStatusesAsync / RequestTestNotificationAsync
      // App Store Connect → Users and Access → Integrations → In-App Purchase: Issuer ID, Key ID, and the downloaded .p8 contents
      // Keep PrivateKey in user-secrets: dotnet user-secrets set "InAppPurchases:Apple:PrivateKey" "$(cat SubscriptionKey_XXXX.p8)"
      "IssuerId": "",
      "KeyId": "",
      "PrivateKey": ""
    },

    "Google": {
      // Your app's package name (must match every RTDN)
      "PackageName": "net.shinylib.paysample",

      // Google Cloud → IAM & Admin → Service Accounts → Keys → Add key (JSON). Invite the service account in
      // Play Console → Users and permissions with "View financial data" and "Manage orders and subscriptions".
      // Required to fetch purchase details for notifications and to verify purchases.
      // Keep it in user-secrets: dotnet user-secrets set "InAppPurchases:Google:ServiceAccountJson" "$(cat service-account.json)"
      "ServiceAccountJson": "",

      // Google Cloud → Pub/Sub → your RTDN topic's push subscription → Enable authentication.
      // PubSubServiceAccountEmail = the service account selected there; PubSubAudience = the audience set there
      // (defaults to the push endpoint URL, e.g. https://api.example.com/iap/google).
      // Play Console → Monetization setup → Real-time developer notifications → topic name.
      "RequirePubSubAuthentication": true,
      "PubSubAudience": "https://api.example.com/iap/google",
      "PubSubServiceAccountEmail": "pubsub-push@your-project.iam.gserviceaccount.com"
    }
  }
}
