<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tv="http://shiny.net/maui/tableview"
             xmlns:vm="clr-namespace:Sample.Maui.Pages.HttpTransfers"
             xmlns:http="clr-namespace:Shiny.Net.Http;assembly=Shiny.Net.Http"
             x:Class="Sample.Maui.Pages.HttpTransfers.HttpTransferListPage"
             x:DataType="vm:HttpTransferListViewModel"
             Title="HTTP Transfers">
    <tv:TableView>
        <tv:TableRoot>
            <tv:TableSection Title="Create">
                <tv:CommandCell Title="New Download" Command="{Binding GoToDownloadCommand}" />
                <tv:CommandCell Title="New Upload" Command="{Binding GoToUploadCommand}" />
                <tv:CommandCell Title="Azure Blob Upload" Command="{Binding GoToAzureBlobCommand}" />
            </tv:TableSection>

            <tv:TableSection Title="Manage">
                <tv:ButtonCell Title="Cancel All" Command="{Binding CancelAllCommand}" ButtonTextColor="Red" />
            </tv:TableSection>

            <tv:TableSection Title="Transfers" ItemsSource="{Binding Transfers}">
                <tv:TableSection.ItemTemplate>
                    <DataTemplate x:DataType="http:HttpTransferObject">
                        <tv:CustomCell>
                            <tv:CustomCell.CustomContent>
                                <VerticalStackLayout Padding="8" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Identifier}" FontAttributes="Bold" />
                                        <Label Grid.Column="1" Text="{Binding Status}" />
                                    </Grid>
                                    <Label Text="{Binding Uri}" FontSize="12" TextColor="Gray" LineBreakMode="TailTruncation" />
                                    <ProgressBar Progress="{Binding PercentComplete}" IsVisible="{Binding IsDeterministic}" ProgressColor="{StaticResource Primary}" />
                                    <Grid ColumnDefinitions="*,*,Auto">
                                        <Label Text="{Binding BytesTransferred, StringFormat='{0:N0} bytes'}" FontSize="12" />
                                        <Label Grid.Column="1" Text="{Binding BytesPerSecond, StringFormat='{0:N0} B/s'}" FontSize="12" />
                                        <Label Grid.Column="2" Text="{Binding EstimatedTimeRemaining, StringFormat='{0:hh\\:mm\\:ss}'}" FontSize="12" />
                                    </Grid>
                                </VerticalStackLayout>
                            </tv:CustomCell.CustomContent>
                        </tv:CustomCell>
                    </DataTemplate>
                </tv:TableSection.ItemTemplate>
            </tv:TableSection>
        </tv:TableRoot>
    </tv:TableView>
</ContentPage>
