<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.Maui.Pages"
             x:Class="Sample.Maui.Pages.JobsPage"
             x:DataType="vm:JobsViewModel"
             Title="Jobs">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="8">
        <HorizontalStackLayout Spacing="8">
            <Button Text="Run All" Command="{Binding RunAllCommand}" />
            <Button Text="Cancel All" Command="{Binding CancelAllCommand}" />
        </HorizontalStackLayout>
        <Label Grid.Row="1" Text="{Binding Status}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Jobs}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:JobViewModel">
                    <Grid Padding="8" ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Identifier}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding LastRunTime}" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
