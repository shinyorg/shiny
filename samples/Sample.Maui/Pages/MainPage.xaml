<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.Maui.Pages"
             x:Class="Sample.Maui.Pages.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Shiny Sample">
    <CollectionView ItemsSource="{Binding Features}" SelectionMode="None">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:FeatureItem">
                <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=NavigateCommand}"
                            CommandParameter="{Binding Route}" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout>
                        <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />
                        <Label Text="{Binding Description}" FontSize="13" TextColor="Gray" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text=">" FontSize="20" VerticalOptions="Center" TextColor="Gray" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
