<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sample="clr-namespace:Sample.Geofencing"
             x:Class="Sample.Geofencing.ListPage"
             x:DataType="sample:ListViewModel"
             Title="Geofences">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Create"
                     Command="{Binding Create}" />
    </ContentPage.ToolbarItems>

    <ContentPage.Content>
        <Grid RowDefinitions="*, Auto">
            <CollectionView ItemsSource="{Binding Geofences}"
                            Grid.Row="0">

                <CollectionView.EmptyView>
                    <Label Text="No Geofences"
                           Style="{StaticResource NoDataLabel}" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="sample:GeofenceRegionViewModel">
                        <Grid RowDefinitions="Auto, Auto, Auto"
                              ColumnDefinitions="1*, 1*"
                              Margin="10">
                            <Label Text="{Binding Text}"
                                   FontSize="Medium"
                                   FontAttributes="Bold" 
                                   Grid.ColumnSpan="2"
                                   Grid.Row="0" />

                            <Label Text="{Binding Detail}"
                                   FontSize="Small"
                                   FontAttributes="Italic" 
                                   Grid.ColumnSpan="2"
                                   Grid.Row="1" />

                            <Button Text="Request State"
                                    Command="{Binding RequestCurrentState}"
                                    TextColor="White"
                                    BackgroundColor="Green"
                                    Grid.Row="2"
                                    Grid.Column="0" />
                                    
                            <Button Text="Remove" 
                                    Command="{Binding Remove}"
                                    TextColor="White"
                                    BackgroundColor="Red"
                                    Grid.Row="2"
                                    Grid.Column="1" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Clear"
                    Command="{Binding DropAllFences}"
                    Grid.Row="1" />
        </Grid>
    </ContentPage.Content>
</ContentPage>