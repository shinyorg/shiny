<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:httpTransfers="clr-namespace:Sample.HttpTransfers"
             x:Class="Sample.HttpTransfers.AzureBlobPage"
             x:DataType="httpTransfers:AzureBlobViewModel"
             Title="Azure Blob Upload">
    
    <TableView Intent="Form">
        <TableRoot>
            <TableSection>
                <EntryCell Label="Connection String" 
                           Text="{Binding ConnectionString}" />
                
                <EntryCell Label="Container Name" 
                           Text="{Binding ContainerName}" />
            </TableSection>
            
            <TableSection>
                <TextCell Text="Queue Upload" 
                          Command="{Binding QueueBlobCommand}" 
                          IsEnabled="True"/>
                
                <TextCell Text="{Binding ProgressText}" />
            </TableSection>
        </TableRoot>
    </TableView>
</ContentPage>