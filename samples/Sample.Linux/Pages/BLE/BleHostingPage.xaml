<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.Linux.Pages.BLE"
             x:Class="Sample.Linux.Pages.BLE.BleHostingPage"
             x:DataType="vm:BleHostingViewModel"
             Title="BLE Hosting">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="{Binding Status, StringFormat='Status: {0}'}" FontAttributes="Bold" />
            <Label Text="{Binding AccessState, StringFormat='Access: {0}'}" />
            <Label Text="{Binding IsAdvertising, StringFormat='Advertising: {0}'}" />
            <Label Text="{Binding SubscriberCount, StringFormat='Subscribers: {0}'}" />
            <Label Text="{Binding LastWrite, StringFormat='Last write: {0}'}" />

            <Button Text="Request Access" Command="{Binding RequestAccessCommand}" />
            <Button Text="Add Service" Command="{Binding AddServiceCommand}" />
            <Button Text="Clear Services" Command="{Binding ClearServicesCommand}" />
            <Button Text="Toggle Advertising" Command="{Binding ToggleAdvertisingCommand}" />
            <Button Text="Notify Subscribers" Command="{Binding NotifySubscribersCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
