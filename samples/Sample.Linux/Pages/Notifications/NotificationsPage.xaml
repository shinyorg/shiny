<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.Linux.Pages.Notifications"
             x:Class="Sample.Linux.Pages.Notifications.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title="Notifications">
    <VerticalStackLayout Padding="16" Spacing="8">
        <Label Text="{Binding Access, StringFormat='Access: {0}'}" />
        <Label Text="Title" />
        <Entry Text="{Binding Title}" />
        <Label Text="Message" />
        <Entry Text="{Binding Message}" />
        <Label Text="{Binding Status, StringFormat='Status: {0}'}" />

        <Button Text="Request Access" Command="{Binding RequestAccessCommand}" />
        <Button Text="Send Now" Command="{Binding SendNowCommand}" />
        <Button Text="Send Scheduled (15s)" Command="{Binding SendScheduledCommand}" />
        <Button Text="Cancel All" Command="{Binding CancelAllCommand}" />
    </VerticalStackLayout>
</ContentPage>
