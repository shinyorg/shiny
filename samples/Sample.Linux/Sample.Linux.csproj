<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <OutputType>Exe</OutputType>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ApplicationTitle>Shiny Sample</ApplicationTitle>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4"/>
        <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials"/>
        <!-- SkiaSharp's net10.0 build only carries macOS + Windows natives; Shiny.Printing.Rendering needs this on Linux -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.BluetoothLE.Linux\Shiny.BluetoothLE.Linux.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.BluetoothLE.Hosting.Linux\Shiny.BluetoothLE.Hosting.Linux.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Core\Shiny.Core.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Hosting.Maui\Shiny.Hosting.Maui.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Notifications.Linux\Shiny.Notifications.Linux.csproj"/>
        <ProjectReference Include="..\Sample.Shared.Maui\Sample.Shared.Maui.csproj"/>
    </ItemGroup>
</Project>
