<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.MacOS.Pages.Battery"
             x:Class="Sample.MacOS.Pages.Battery.BatteryPage"
             x:DataType="vm:BatteryViewModel"
             Title="Battery">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Status" FontAttributes="Bold" />
        <Label Text="{Binding Status}" />

        <Label Text="Level" FontAttributes="Bold" />
        <Label Text="{Binding Level, StringFormat='{0:P0}'}" />

        <ProgressBar Progress="{Binding Level}" />
    </VerticalStackLayout>
</ContentPage>
