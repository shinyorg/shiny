<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.MacOS.Pages.Push"
             x:Class="Sample.MacOS.Pages.Push.PushPage"
             x:DataType="vm:PushViewModel"
             Title="Push Notifications">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Button Text="Get Current Access" Command="{Binding GetCurrentAccessCommand}" />
        <Button Text="Request Access" Command="{Binding RequestAccessCommand}" />
        <Button Text="Unregister" Command="{Binding UnRegisterCommand}" />

        <Label Text="Status" FontAttributes="Bold" />
        <Label Text="{Binding Status}" />

        <Label Text="Registration Token" FontAttributes="Bold" />
        <Label Text="{Binding RegistrationToken}" LineBreakMode="CharacterWrap" />

        <Label Text="Native Token" FontAttributes="Bold" />
        <Label Text="{Binding NativeToken}" LineBreakMode="CharacterWrap" />
    </VerticalStackLayout>
</ContentPage>
