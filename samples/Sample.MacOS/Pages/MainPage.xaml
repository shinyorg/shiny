<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.MacOS.Pages"
             x:Class="Sample.MacOS.Pages.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Shiny BLE Sample">
    <VerticalStackLayout Padding="16" Spacing="8">
        <Button Text="BLE Scanner"
                Command="{Binding NavigateCommand}"
                CommandParameter="blescan" />
        <Button Text="BLE Hosting"
                Command="{Binding NavigateCommand}"
                CommandParameter="blehosting" />
        <Button Text="Push Notifications"
                Command="{Binding NavigateCommand}"
                CommandParameter="push" />
        <Button Text="Local Notifications"
                Command="{Binding NavigateCommand}"
                CommandParameter="notifications" />
        <Button Text="Battery"
                Command="{Binding NavigateCommand}"
                CommandParameter="battery" />
        <Button Text="Connectivity"
                Command="{Binding NavigateCommand}"
                CommandParameter="connectivity" />
        <Button Text="HTTP Transfers"
                Command="{Binding NavigateCommand}"
                CommandParameter="httptransfers" />
    </VerticalStackLayout>
</ContentPage>
