<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.MacOS.Pages.Notifications"
             x:Class="Sample.MacOS.Pages.Notifications.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title="Local Notifications">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Button Text="Request Access" Command="{Binding RequestAccessCommand}" />

            <Label Text="Status" FontAttributes="Bold" />
            <Label Text="{Binding Status}" />

            <Label Text="Title" FontAttributes="Bold" />
            <Entry Text="{Binding NotifTitle, Mode=TwoWay}" Placeholder="Notification title" />

            <Label Text="Message" FontAttributes="Bold" />
            <Entry Text="{Binding NotifMessage, Mode=TwoWay}" Placeholder="Required" />

            <Label Text="Subtitle" FontAttributes="Bold" />
            <Entry Text="{Binding Subtitle, Mode=TwoWay}" Placeholder="Optional subtitle" />

            <Label Text="Delay (seconds, 0 = immediate)" FontAttributes="Bold" />
            <Entry Text="{Binding DelaySeconds, Mode=TwoWay}" Keyboard="Numeric" />

            <Button Text="Send Notification" Command="{Binding SendCommand}" />

            <Label Text="{Binding PendingCount, StringFormat='Pending: {0}'}" FontAttributes="Bold" />
            <Button Text="Cancel All" Command="{Binding CancelAllCommand}" />
            <Button Text="Refresh Pending" Command="{Binding RefreshPendingCommand}" />

            <CollectionView ItemsSource="{Binding PendingNotifications}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PendingNotificationViewModel">
                        <VerticalStackLayout Padding="0,8" Spacing="2">
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <Label Text="{Binding Message}" />
                            <Label Text="{Binding TriggerInfo}" FontSize="Micro" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
