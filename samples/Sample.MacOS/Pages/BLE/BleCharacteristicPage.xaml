<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sample.MacOS.Pages.BLE"
             x:Class="Sample.MacOS.Pages.BLE.BleCharacteristicPage"
             x:DataType="vm:BleCharacteristicViewModel"
             Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="8">
        <Label Text="{Binding Status}" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding Characteristics}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:BleCharacteristicItemViewModel">
                    <Border Stroke="LightGray" StrokeThickness="1" Padding="12" Margin="0,4">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Uuid}" FontAttributes="Bold" />
                            <Label Text="{Binding Properties}" FontSize="12" TextColor="Gray" />
                            <Label Text="{Binding Value}" FontSize="12" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Read" Command="{Binding ReadCommand}" IsVisible="{Binding CanRead}" HeightRequest="36" FontSize="12" />
                                <Button Text="{Binding NotifyText}" Command="{Binding ToggleNotifyCommand}" IsVisible="{Binding CanNotify}" HeightRequest="36" FontSize="12" />
                            </HorizontalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanWrite}">
                                <Entry Placeholder="Hex bytes (e.g. 01FF)" Text="{Binding WriteValue}" />
                                <Button Grid.Column="1" Text="Write" Command="{Binding WriteCommand}" HeightRequest="36" FontSize="12" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
