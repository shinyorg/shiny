<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Shiny.ScreenRecorder: ScreenCaptureKit's microphone capture (macOS 15+). The Screen
         Recording grant itself is a TCC prompt, not an Info.plist key. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Records narration alongside a screen recording</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>This sample discovers and prints to receipt printers on your local network.</string>
    <key>NSBonjourServices</key>
    <array>
        <!-- Shiny.Printers.Network: raw (port 9100) and LPR receipt printers -->
        <string>_pdl-datastream._tcp</string>
        <string>_printer._tcp</string>
    </array>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>This app uses Bluetooth to scan for and connect to nearby devices</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>This app uses Bluetooth to communicate with peripherals</string>
</dict>
</plist>
