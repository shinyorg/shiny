<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.device.bluetooth</key>
    <true/>
    <!-- PC/SC (NFC page): a sandboxed app needs this to reach a smart card / NFC reader -->
    <key>com.apple.security.smartcard</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Shiny.Printing: the macOS head prints through CUPS (lp), which a sandboxed app can only reach with this -->
    <key>com.apple.security.print</key>
    <true/>
    <!-- Shiny.ScreenRecorder: a sandboxed app needs this to mix the microphone into a recording.
         Screen capture itself is gated by the Screen Recording TCC grant, not by an entitlement. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
