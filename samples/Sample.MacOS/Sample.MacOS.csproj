<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)-macos</TargetFramework>
        <OutputType>Exe</OutputType>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>

        <!--the application title will be the exe name, debuggers will try to launch on the assembly name-->
        <ApplicationTitle>Sample.MacOS</ApplicationTitle>
        <ApplicationId>org.shiny.sample</ApplicationId>
        <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS" />
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" VersionOverride="10.0.8"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Sample.Shared.Maui\Sample.Shared.Maui.csproj" />
    </ItemGroup>
</Project>
