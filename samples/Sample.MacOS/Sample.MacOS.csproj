<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)-macos</TargetFramework>
        <OutputType>Exe</OutputType>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>

        <!--the application title will be the exe name, debuggers will try to launch on the assembly name-->
        <ApplicationTitle>Sample.MacOS</ApplicationTitle>
        <ApplicationId>org.shiny.sample</ApplicationId>
        <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    </PropertyGroup>

    <!--
        Capabilities that need a provisioning profile carrying them, on for this repo's org.shiny.sample App ID. To run
        the sample under your own team, change ApplicationId, enable the capability on your App ID in the Apple developer
        portal and download a fresh development profile - or comment the entitlement out: a profile without the
        capability fails the signing step. The sandbox entitlements in Entitlements.plist need no profile.
    -->
    <ItemGroup>
        <!-- Push page: Push Notifications capability -->
        <CustomEntitlements Include="aps-environment" Type="String" Value="development" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS" />
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" VersionOverride="10.0.8"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Sample.Shared.Maui\Sample.Shared.Maui.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Hosting.Maui\Shiny.Hosting.Maui.csproj" />
    </ItemGroup>
</Project>
