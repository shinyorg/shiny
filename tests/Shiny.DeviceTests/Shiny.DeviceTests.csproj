<Project Sdk="Microsoft.NET.Sdk">

    <!--
        End-to-end tests that run inside a real app on a simulator, emulator or device. Driven by
        Shiny.DeviceTests.Runner through the MAUI DevFlow agent - see readme.md. Not part of Build.slnf.
    -->
    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework)-android</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(TargetFrameworks);$(BaseTargetFramework)-ios;$(BaseTargetFramework)-maccatalyst</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>Shiny.DeviceTests</RootNamespace>

        <ApplicationTitle>Shiny Device Tests</ApplicationTitle>
        <ApplicationId>org.shiny.devicetests</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <CustomEntitlements Include="com.apple.security.app-sandbox" Type="Boolean" Value="true" Visible="false" />
        <CustomEntitlements Include="com.apple.security.network.client" Type="Boolean" Value="true" Visible="false" />
        <!-- the DevFlow agent and the Discovery suite's published service listen on sockets -->
        <CustomEntitlements Include="com.apple.security.network.server" Type="Boolean" Value="true" Visible="false" />
        <CustomEntitlements Include="com.apple.security.device.bluetooth" Type="Boolean" Value="true" Visible="false" />
        <CustomEntitlements Include="com.apple.security.personal-information.location" Type="Boolean" Value="true" Visible="false" />
        <CustomEntitlements Include="com.apple.security.personal-information.addressbook" Type="Boolean" Value="true" Visible="false" />
        <CustomEntitlements Include="com.apple.security.personal-information.calendars" Type="Boolean" Value="true" Visible="false" />
    </ItemGroup>

    <!--
        The Push suite's image test needs the notification service extension. NuGet consumers get Shiny.Push.targets from
        buildTransitive/; this app uses project references, so it is imported at the bottom of this file.
    -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <ShinyPushServiceExtension>true</ShinyPushServiceExtension>
        <ShinyPushServiceExtensionInfoPlist>Platforms/iOS/NotificationService.plist</ShinyPushServiceExtensionInfoPlist>
    </PropertyGroup>

    <!-- without it Declared Age Range never answers (the Family extension rejects the client and the call hangs) -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <CustomEntitlements Include="com.apple.developer.declared-age-range" Type="Boolean" Value="true" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" />
        <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#0B0E17" BaseSize="200,200" />
        <MauiImage Include="Resources\Images\*" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Shiny.DeviceTests.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
        <!-- always on here (not Debug-only like the samples): the runner drives every test through it -->
        <PackageReference Include="Microsoft.Maui.DevFlow.Agent" />
        <PackageReference Include="xunit.assert" />
        <!-- direct reference so the [ShinyJsonContext] generator runs here (DataSync registers its entity through it) -->
        <PackageReference Include="Shiny.Extensions.Serialization" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.Hosting.Maui\Shiny.Hosting.Maui.csproj" />
        <ProjectReference Include="..\..\src\Shiny.BluetoothLE\Shiny.BluetoothLE.csproj" />
        <ProjectReference Include="..\..\src\Shiny.BluetoothLE.Hosting\Shiny.BluetoothLE.Hosting.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Calendar\Shiny.Calendar.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Contacts\Shiny.Contacts.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Net.Discovery\Shiny.Net.Discovery.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Net.Http\Shiny.Net.Http.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Data.Sync\Shiny.Data.Sync.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Printers.Network\Shiny.Printers.Network.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Gps\Shiny.Gps.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Geofencing\Shiny.Geofencing.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Notifications\Shiny.Notifications.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Push\Shiny.Push.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Jobs\Shiny.Jobs.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Mobile.LiveActivities\Shiny.Mobile.LiveActivities.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Mobile.CallDirectory\Shiny.Mobile.CallDirectory.csproj" />
        <ProjectReference Include="..\..\src\Shiny.AgeSignals\Shiny.AgeSignals.csproj" />
    </ItemGroup>

    <Import Project="..\..\src\Shiny.Push\buildTransitive\Shiny.Push.targets" />

</Project>
