<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <MsftExtensionVersion>10.0.5</MsftExtensionVersion>
        <MauiLabsVersion>0.1.0-preview.11.26317.2</MauiLabsVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageVersion Include="Shiny.Maui.Shell" Version="6.3.1"/>
        <PackageVersion Include="Shiny.Maui.Controls" Version="1.0.1-beta-0141"/>
        <PackageVersion Include="Shiny.Extensions.DependencyInjection" Version="5.1.1"/>
        <PackageVersion Include="Shiny.Extensions.Stores" Version="5.1.1"/>
        <PackageVersion Include="Shiny.Extensions.Stores.Web" Version="5.1.1"/>
        <PackageVersion Include="Shiny.Extensions.Serialization" Version="5.1.1"/>
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.DevFlow.Agent" Version="$(MauiLabsVersion)"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="Nerdbank.GitVersioning" Version="3.9.50"/>
        <PackageVersion Include="Microsoft.Maui.Core" Version="$(MauiVersion)"/>
        <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.0.1"/>
        <PackageVersion Include="System.Reactive" Version="6.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.5.2"/>
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.7.0"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Azure.NotificationHubs" Version="4.2.0"/>
        <PackageVersion Include="Microsoft.JSInterop" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.1"/>
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Shiny.DocumentDb.Sqlite" Version="9.1.0"/>
        <PackageVersion Include="Shiny.DocumentDb.Extensions.DependencyInjection" Version="9.1.0"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0"/>
        <PackageVersion Include="xunit" Version="2.9.3"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="Xamarin.AndroidX.Core" Version="1.17.0.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.10.0.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Common" Version="2.10.0.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.10.0.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.10.0.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Android" Version="2.10.0.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.10.0.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.10.0.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.10.0.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState.Android" Version="2.10.0.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.10.0.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.10.0.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.10.0.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Fragment" Version="1.8.9.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Activity" Version="1.12.4.1"/>
        <PackageVersion Include="Xamarin.AndroidX.Activity.Ktx" Version="1.12.4.1"/>
        <PackageVersion Include="Xamarin.AndroidX.SavedState" Version="1.4.0.2"/>
        <PackageVersion Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.4.0.2"/>
        <PackageVersion Include="Xamarin.AndroidX.AppCompat" Version="1.7.1.3"/>
        <PackageVersion Include="Xamarin.GooglePlayServices.Location" Version="121.3.0.9"/>
        <PackageVersion Include="Xamarin.AndroidX.Preference" Version="1.2.1.17"/>
        <PackageVersion Include="Xamarin.Firebase.Messaging" Version="125.0.1.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Work.Runtime" Version="2.11.1.1"/>
    </ItemGroup>
</Project>