<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <MsftExtensionVersion>11.0.0</MsftExtensionVersion>
        <MauiLabsVersion>0.1.0-preview.16.26575.3</MauiLabsVersion>
        <MauiVersion>11.0.10</MauiVersion>
        <AvaloniaVersion>12.1.5</AvaloniaVersion>
        <!-- the Uno.WinUI / Uno.Extensions versions Uno.Sdk 7.0.22 resolves (samples/Sample.Uno builds on that Sdk; Uno 7 is the first with net11.0) -->
        <UnoVersion>7.0.65</UnoVersion>
        <UnoExtensionsVersion>8.0.1</UnoExtensionsVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageVersion Include="Shiny.Maui.Shell" Version="8.0.1"/>
        <PackageVersion Include="Shiny.Maui.Controls" Version="1.6.0"/>
        <PackageVersion Include="Shiny.Extensions.DependencyInjection" Version="6.0.0"/>
        <PackageVersion Include="Shiny.Extensions.Stores" Version="6.0.0"/>
        <PackageVersion Include="Shiny.Extensions.Serialization" Version="6.0.0"/>
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.DevFlow.Agent" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)"/>
        <PackageVersion Include="Avalonia.Android" Version="$(AvaloniaVersion)"/>
        <PackageVersion Include="Avalonia.iOS" Version="$(AvaloniaVersion)"/>
        <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)"/>
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)"/>
        <PackageVersion Include="Uno.WinUI" Version="$(UnoVersion)"/>
        <PackageVersion Include="Uno.Extensions.Hosting.WinUI" Version="$(UnoExtensionsVersion)"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0"/>
        <PackageVersion Include="PolySharp" Version="1.15.0"/>
        <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.10.1"/>
        <PackageVersion Include="Microsoft.Maui.Core" Version="$(MauiVersion)"/>
        <!-- Microsoft.Maui.Essentials 11.0.10 and Uno.WinUI 7 both require 2.5.1 on Windows -->
        <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1"/>
        <PackageVersion Include="System.Reactive" Version="7.0.0"/>
        <PackageVersion Include="System.Formats.Cbor" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.1"/>
        <PackageVersion Include="Microsoft.Extensions.AI" Version="10.8.1"/>
        <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.1"/>
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Azure.NotificationHubs" Version="4.2.0"/>
        <PackageVersion Include="Microsoft.JSInterop" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Win32.SystemEvents" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Xamarin.Google.Android.Play.Review" Version="2.0.2.7"/>
        <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.1"/>
        <PackageVersion Include="SkiaSharp" Version="4.151.1"/>
        <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1"/>
        <PackageVersion Include="System.Drawing.Common" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Shiny.DocumentDb.Sqlite" Version="15.0.0"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1"/>
        <PackageVersion Include="xunit" Version="2.9.3"/>
        <PackageVersion Include="xunit.assert" Version="2.9.3"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5"/>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Scalar.AspNetCore" Version="2.17.14"/>
    </ItemGroup>
    <!--
        AndroidX floor: Microsoft.Maui.Controls 11.0.10 (via Google Material 1.14.0.5 and Essentials) depends on exactly
        Core 1.19.0.1, Activity 1.13.0.1, Fragment 1.8.9.3, AppCompat 1.7.1.4 and Lifecycle 2.11.0.1 - the pins below - so
        a MAUI 11 app resolves the same AndroidX graph Shiny builds against. Raising Fragment to 1.9 / AppCompat to 1.8
        is fine for consumers (Uno.Sdk 7 already brings them), but nothing here needs it yet.
    -->
    <ItemGroup>
        <PackageVersion Include="Xamarin.AndroidX.Core" Version="1.19.0.1"/>
        <!-- Shiny.Core's AndroidScreenPosture (Jetpack WindowManager); pulls Window + Window.WindowCore 1.5.1.3 -->
        <PackageVersion Include="Xamarin.AndroidX.Window.WindowJava" Version="1.5.1.3"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Common" Version="2.11.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.11.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Android" Version="2.11.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.11.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.11.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState.Android" Version="2.11.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.11.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.11.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.Fragment" Version="1.8.9.3"/>
        <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.4"/>
        <PackageVersion Include="Xamarin.AndroidX.Activity" Version="1.13.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.Activity.Ktx" Version="1.13.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.SavedState" Version="1.5.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.5.0.1"/>
        <PackageVersion Include="Xamarin.AndroidX.AppCompat" Version="1.7.1.4"/>
        <PackageVersion Include="Xamarin.GooglePlayServices.Location" Version="121.3.0.9"/>
        <PackageVersion Include="Xamarin.GooglePlayServices.Wearable" Version="120.0.1.1"/>
        <!-- 121.0.0.4 (not 122.x): 122 pulls Play Services Base 118.11 -> AndroidX.Fragment 1.9, above the pins here -->
        <PackageVersion Include="Xamarin.GooglePlayServices.Games.V2" Version="121.0.0.4"/>
        <!-- satisfy the Play Age Signals AAR's Maven dependencies (Shiny.AgeSignals) at the versions Games.V2 / Play.Review already resolve -->
        <PackageVersion Include="Xamarin.GooglePlayServices.Basement" Version="118.10.0.2"/>
        <PackageVersion Include="Xamarin.GooglePlayServices.Tasks" Version="118.4.1.2"/>
        <PackageVersion Include="Xamarin.Google.Android.Play.Core.Common" Version="2.0.4.9"/>
        <!-- 1.1.0.33 depends on exactly the AndroidX pins above (Fragment 1.8.9.3, Activity 1.13, Core 1.19) -->
        <PackageVersion Include="Xamarin.AndroidX.Biometric" Version="1.1.0.33"/>
        <PackageVersion Include="Xamarin.AndroidX.Preference" Version="1.2.1.18"/>
        <PackageVersion Include="Xamarin.Firebase.Messaging" Version="125.0.1.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Work.Runtime" Version="2.11.2.1"/>
        <!-- 9.1.0 (not .2): later binding revisions need AndroidX.Fragment 1.9 / Play Services Location 121.4, above the pins here -->
        <PackageVersion Include="Xamarin.Android.Google.BillingClient" Version="9.1.0"/>
    </ItemGroup>
</Project>