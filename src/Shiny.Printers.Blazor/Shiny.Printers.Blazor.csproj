<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>Shiny.Printers.Blazor</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Description>Shiny Printers for Blazor - Web Bluetooth, Web Serial and WebUSB transports so a Blazor WebAssembly or Server app can drive an ESC/POS thermal printer directly</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.JSInterop" />
        <PackageReference Include="System.Reactive" />
        <ProjectReference Include="..\Shiny.Printers\Shiny.Printers.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.Printers.Tests" />
    </ItemGroup>

</Project>
