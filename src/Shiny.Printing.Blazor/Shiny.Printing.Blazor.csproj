<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>Shiny.Printing.Blazor</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Description>Shiny Printing for Blazor - prints PDF, image and HTML content through the browser print dialog (window.print) from Blazor WebAssembly or Server</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.JSInterop" />
        <ProjectReference Include="..\Shiny.Printing\Shiny.Printing.csproj" />
    </ItemGroup>

</Project>
