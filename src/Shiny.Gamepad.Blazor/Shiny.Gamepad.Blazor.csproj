<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <Description>Shiny Gamepad for Blazor WebAssembly - reads game controllers through the W3C Gamepad API, with dual-rumble vibration where the browser supports it</Description>
        <RootNamespace>Shiny.Gamepad</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Core\Shiny.Core.csproj" />
        <ProjectReference Include="..\Shiny.Gamepad\Shiny.Gamepad.csproj" />
        <ProjectReference Include="..\Shiny.Core.Blazor\Shiny.Core.Blazor.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.JSInterop" />
    </ItemGroup>

</Project>
