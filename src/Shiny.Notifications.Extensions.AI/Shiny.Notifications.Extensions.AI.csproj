<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>Shiny.Notifications.Extensions.AI</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <Description>Microsoft.Extensions.AI tool surface for Shiny.Notifications - exposes local notifications as reminder-style AIFunction tools for LLM tool-calling.</Description>
        <PackageTags>shiny notifications reminders ai aifunction mcp llm tools aot</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
        <ProjectReference Include="..\Shiny.Notifications\Shiny.Notifications.csproj" />
    </ItemGroup>

</Project>
