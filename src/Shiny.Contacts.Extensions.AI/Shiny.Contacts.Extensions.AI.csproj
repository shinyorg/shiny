<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>Shiny.Contacts.Extensions.AI</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <Description>Microsoft.Extensions.AI tool surface for Shiny.Contacts - exposes IContactStore reads/writes as AIFunction tools for LLM tool-calling.</Description>
        <PackageTags>shiny contacts ai aifunction mcp llm tools aot</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
        <ProjectReference Include="..\Shiny.Contacts\Shiny.Contacts.csproj" />
    </ItemGroup>

</Project>
