<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(WindowsTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(AndroidTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(IosTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(MacCatalystTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(MacOsTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(TvOsTarget)</TargetFrameworks>
        
        <Description>The Shiny Core Foundation where all Shiny modules are built on</Description>
        <RootNamespace>Shiny</RootNamespace>
    </PropertyGroup>
    
    <ItemGroup>
        <None Include="Shiny.Core.targets" Pack="True" PackagePath="buildTransitive" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Shiny.Extensions.DependencyInjection" />
        <PackageReference Include="Shiny.Extensions.Stores" />
    </ItemGroup>

    <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
        <PackageReference Include="Xamarin.AndroidX.Core" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common" />
    </ItemGroup>
</Project>