<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into every consuming app by the Android manifest merger, so apps declare nothing.
  The package attribute is required: without it CreateAar silently skips this file.
  The three assets are generated into the app by Shiny.AppFunctions.targets.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="shiny.appfunctions">
	<application>
		<service
			android:name="shiny.appfunctions.ShinyAppFunctionService"
			android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
			android:exported="true">
			<property android:name="android.app.appfunctions" android:value="app_functions.xml" />
			<property android:name="android.app.appfunctions.schema" android:value="app_functions_schema.xsd" />
			<property android:name="android.app.appfunctions.v2" android:value="app_functions_v2.xml" />
			<intent-filter>
				<action android:name="android.app.appfunctions.AppFunctionService" />
			</intent-filter>
		</service>
	</application>
</manifest>
