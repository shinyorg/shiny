<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(WindowsTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(AndroidTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(IosTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(MacCatalystTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(MacOsTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(TvOsTarget)</TargetFrameworks>
        
        <Description>Shiny addon for all your push notification needs - iOS, tvOS, Mac Catalyst, macOS, Android, Windows and Blazor WebAssembly (Web Push)</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Core\Shiny.Core.csproj" />
    </ItemGroup>

    <!--
        The base target framework is also the Blazor WebAssembly build - AddPush(WebPushOptions) registers the
        Web Push backend (Platforms\Net\Browser), which imports wwwroot/push.js and registers
        wwwroot/push-sw.js (served from _content/Shiny.Push/), hence the Razor SDK.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == '$(BaseTargetFramework)'">
        <PackageReference Include="Microsoft.JSInterop" />
    </ItemGroup>

    <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
        <PackageReference Include="Xamarin.Firebase.Messaging"/>
    </ItemGroup>

</Project>
