<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>Shiny.AppFunctions.Extensions.AI</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <Description>Microsoft.Extensions.AI tool surface for Shiny.AppFunctions - exposes the app functions Siri and Gemini call as AIFunction tools for an in-app LLM, through the same binding, delegates and handlers.</Description>
        <PackageTags>shiny appfunctions app intents siri gemini ai aifunction mcp llm tools aot</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
        <ProjectReference Include="..\Shiny.AppFunctions\Shiny.AppFunctions.csproj" />
        <InternalsVisibleTo Include="Shiny.AppFunctions.Tests" />
    </ItemGroup>

</Project>
