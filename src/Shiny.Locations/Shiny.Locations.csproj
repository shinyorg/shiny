<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Meta-package: Shiny.Locations was split into Shiny.Gps (GPS, motion activity, geocoding) and
        Shiny.Geofencing. This package ships no assembly of its own - it only depends on both, so existing
        apps keep working by updating the version. The types kept the Shiny.Locations namespace.
    -->
    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(WindowsTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(AndroidTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(IosTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(MacCatalystTarget)</TargetFrameworks>

        <Description>Shiny Locations - meta-package that brings in Shiny.Gps (GPS, motion activity, geocoding) and Shiny.Geofencing</Description>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeSymbols>false</IncludeSymbols>
        <IncludeSource>false</IncludeSource>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- NU5128: dependency groups with no matching lib folder - expected for a meta-package -->
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Gps\Shiny.Gps.csproj" />
        <ProjectReference Include="..\Shiny.Geofencing\Shiny.Geofencing.csproj" />
    </ItemGroup>
</Project>
