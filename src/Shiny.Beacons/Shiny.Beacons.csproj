<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(WindowsTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(AndroidTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(IosTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(MacCatalystTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(MacOsTarget)</TargetFrameworks>

        <Description>Shiny Beacons - iBeacon and Eddystone ranging, monitoring and broadcasting</Description>
        <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Reactive" />
        <!-- direct reference so the [ShinyJsonContext] analyzer runs against this project -->
        <PackageReference Include="Shiny.Extensions.Serialization" />
        <ProjectReference Include="..\Shiny.Core\Shiny.Core.csproj" />
        <ProjectReference Include="..\Shiny.BluetoothLE\Shiny.BluetoothLE.csproj" />
        <ProjectReference Include="..\Shiny.BluetoothLE.Hosting\Shiny.BluetoothLE.Hosting.csproj" />
    </ItemGroup>

    <Import Project="$(MSBuildThisFileDirectory)..\..\Directory.Build.targets" />

    <!--
        macOS reuses the Apple beacon code. CoreLocation on macOS binds CLBeacon ranging but has no
        beacon region monitoring at all, so the monitoring manager is carved out with #if MACOS
        rather than duplicated into Platforms\MacOS.
    -->
    <ItemGroup Condition="$(TargetFramework.Contains('-macos'))">
        <Compile Include="Platforms\Apple\**\*.cs" />
    </ItemGroup>

</Project>
