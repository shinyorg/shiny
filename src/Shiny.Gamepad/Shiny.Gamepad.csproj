<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(WindowsTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(AndroidTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(IosTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(MacCatalystTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(MacOsTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(TvOsTarget)</TargetFrameworks>

        <RootNamespace>Shiny.Gamepad</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <Description>Shiny Gamepad - read sticks, triggers and buttons from game controllers, with rumble, battery, motion and light-bar support, on Android, iOS, tvOS, Mac Catalyst, macOS and Windows</Description>

        <!-- imported explicitly below so Platforms\Apple can also be compiled into the macOS target -->
        <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Core\Shiny.Core.csproj" />
    </ItemGroup>

    <Import Project="$(MSBuildThisFileDirectory)..\..\Directory.Build.targets" />

    <!--
        GameController is one framework across all four Apple platforms - GCController, GCExtendedGamepad,
        GCMotion, GCDeviceLight and GCDeviceHaptics are bound identically in Microsoft.iOS.dll,
        Microsoft.tvOS.dll, Microsoft.MacCatalyst.dll and Microsoft.macOS.dll - so there is one Apple
        backend rather than an AppKit one and a UIKit one. Directory.Build.targets only routes
        Platforms\Apple to ios/maccatalyst/tvos, and gives -macos its own Platforms\MacOS folder, so the
        macOS target has to be pointed at the shared code here.
    -->
    <ItemGroup Condition="$(TargetFramework.Contains('-macos'))">
        <Compile Include="Platforms\Apple\**\*.cs" />
    </ItemGroup>

</Project>
