<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(WindowsTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(AndroidTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(IosTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(MacCatalystTarget)</TargetFrameworks>

        <Description>Shiny GPS - foreground and background GPS, motion activity recognition and reverse geocoding</Description>
        <RootNamespace>Shiny.Locations</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Shiny.Extensions.Serialization" />
        <ProjectReference Include="..\Shiny.Core\Shiny.Core.csproj" />
    </ItemGroup>

    <!--
        The base target framework is also the Blazor WebAssembly build: the browser Geolocation API
        backend imports wwwroot/gps.js (served from _content/Shiny.Gps/), hence the Razor SDK.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == '$(BaseTargetFramework)'">
        <PackageReference Include="Microsoft.JSInterop" />
    </ItemGroup>

    <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
        <PackageReference Include="Xamarin.GooglePlayServices.Location" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Android" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState.Android" />
    </ItemGroup>
</Project>
