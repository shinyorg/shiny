<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(WindowsTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(AndroidTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(IosTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(MacCatalystTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(MacOsTarget)</TargetFrameworks>

        <RootNamespace>Shiny.Net.Discovery</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <Description>Shiny Network Discovery - cross-platform mDNS/DNS-SD (Bonjour) service browsing, resolution and publishing</Description>

        <!-- imported explicitly below so Platforms\Apple can be re-added for -macos -->
        <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    </PropertyGroup>

    <!--
        NSNetService is soft-deprecated in favour of Network.framework, but NWListener can only
        advertise a port it owns the listener for and NWBrowser has no publish path at all, so it
        cannot back this API. NSNetService still ships and, unlike raw multicast sockets, needs no
        com.apple.developer.networking.multicast entitlement. Revisit if Apple ever removes it.
    -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-ios')) OR $(TargetFramework.Contains('maccatalyst')) OR $(TargetFramework.Contains('-macos'))">
        <NoWarn>$(NoWarn);CA1422</NoWarn>
    </PropertyGroup>

    <!--
        The managed responder only ships where there is no OS-level DNS-SD daemon to lean on:
        plain .NET (Linux/macOS console/server) and Windows. Android and Apple delegate to
        NsdManager / NSNetService instead.
    -->
    <ItemGroup Condition="$(TargetFramework.Contains('-android')) OR $(TargetFramework.Contains('-ios')) OR $(TargetFramework.Contains('maccatalyst')) OR $(TargetFramework.Contains('-macos'))">
        <Compile Remove="Managed\**\*.cs" />
        <None Include="Managed\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Core\Shiny.Core.csproj" />
    </ItemGroup>

    <Import Project="$(MSBuildThisFileDirectory)..\..\Directory.build.targets" />

    <!-- the NSNetService code is identical on macOS, so there is no separate Platforms\MacOS -->
    <ItemGroup Condition="$(TargetFramework.Contains('-macos'))">
        <Compile Include="Platforms\Apple\**\*.cs" />
    </ItemGroup>

</Project>
