<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(WindowsTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(AndroidTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(IosTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(MacCatalystTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(TvOsTarget)</TargetFrameworks>

        <Description>Shiny addon for adding upload and download management to your app (with metrics!) - iOS, tvOS, Mac Catalyst, Android, Windows, Linux, macOS and Blazor WebAssembly (Service Worker Background Sync)</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http"/>
        <PackageReference Include="Shiny.Extensions.Serialization"/>
        <ProjectReference Include="..\Shiny.Core\Shiny.Core.csproj"/>
    </ItemGroup>

    <!--
        The base target framework is also the Blazor WebAssembly build - AddBlazorHttpTransfers() registers the
        Service Worker backend (Platforms\Net\Browser), which imports wwwroot/http-transfer.js and registers
        wwwroot/http-transfer-sw.js (served from _content/Shiny.Net.Http/), hence the Razor SDK.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == '$(BaseTargetFramework)'">
        <PackageReference Include="Microsoft.JSInterop"/>
    </ItemGroup>

    <!-- iOS only. ActivityKit is unavailable on Mac Catalyst and tvOS (the framework ships in those SDKs
         but every type in it is marked @available(..., unavailable)), so neither the reference nor
         Platforms\iOS is worth carrying there. Android draws progress on the foreground-service
         notification it already posts and needs nothing from this package. -->
    <ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
        <ProjectReference Include="..\Shiny.Mobile.LiveActivities\Shiny.Mobile.LiveActivities.csproj"/>
    </ItemGroup>

</Project>