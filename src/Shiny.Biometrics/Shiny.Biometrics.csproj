<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(WindowsTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(AndroidTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(IosTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(MacCatalystTarget)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(MacOsTarget)</TargetFrameworks>

        <RootNamespace>Shiny.Biometrics</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Description>Shiny Biometrics - verify the device owner with Touch ID, Face ID and Optic ID (iOS, Mac Catalyst, macOS), fingerprint, face and iris (Android BiometricPrompt) and Windows Hello, with an optional passcode / PIN fallback</Description>
        <PackageTags>shiny biometrics biometric authentication touchid faceid opticid fingerprint face windows-hello localauthentication biometricprompt maui ios android macos windows</PackageTags>

        <!-- imported explicitly below so Platforms\Apple can also be compiled into the macOS target -->
        <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Core\Shiny.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.Biometrics.Tests" />
    </ItemGroup>

    <!-- BiometricPrompt + BiometricManager; the AAR's manifest brings USE_BIOMETRIC / USE_FINGERPRINT -->
    <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
        <PackageReference Include="Xamarin.AndroidX.Biometric" />
    </ItemGroup>

    <Import Project="$(MSBuildThisFileDirectory)..\..\Directory.Build.targets" />

    <!-- LocalAuthentication is the same on iOS, Mac Catalyst and macOS; Directory.Build.targets only routes Platforms\Apple to ios/maccatalyst/tvos -->
    <ItemGroup Condition="$(TargetFramework.Contains('-macos'))">
        <Compile Include="Platforms\Apple\**\*.cs" />
    </ItemGroup>

</Project>
