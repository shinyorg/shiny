<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <Description>Shiny Wi-Fi for Linux via NetworkManager/D-Bus - scanning, connect/disconnect, current network (IP/DNS), access point hosting and airplane mode</Description>
        <RootNamespace>Shiny.Net.Wifi</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Shiny.Core\Shiny.Core.csproj" />
        <ProjectReference Include="..\Shiny.Net.Wifi\Shiny.Net.Wifi.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Tmds.DBus.Protocol" />
    </ItemGroup>
</Project>
